{
  "manifest_version": 3,
  "key": "",
  "name": "FR24 Filter Colours",
  "version": "2.1",
  "description": "Colour-code aircraft on Flightradar24 by filter group so you can instantly see which category each flight belongs to.",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://www.flightradar24.com/*", "https://flightradar24.com/*"],
  "content_scripts": [{
    "matches": ["https://www.flightradar24.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FR24 Filter Colours",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["injected.js"],
    "matches": ["https://www.flightradar24.com/*"]
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "fr24-filter-colours@extension",
      "strict_min_version": "121.0"
    }
  }
}
